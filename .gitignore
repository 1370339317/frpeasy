# ============================================================
# 构建产物
# ============================================================
/frpeasy-panel
/frpeasy-agent
/frpeasy-panel.exe
/frpeasy-agent.exe
*.exe
*.exe.prev
/bin/

# ============================================================
# 运行数据（真实部署与测试都会在这里落库 / 落二进制）
#
# 这些目录里有 SQLite 库、frps/frpc 二进制、日志、令牌，
# 体积大且每次运行都变，绝不能入库。
# ============================================================
/data/
/agent-data/
/agent-live/
/it-data/
/smoke-data/
/dbg-data/
/ag-data/
/ag-agent/
/ag2-data/
/ag2-agent/

# 测试脚本每次运行用「独立端口 + 独立数据目录」，名字带随机后缀，
# 所以只能用通配前缀匹配。
/e2e-data-*/
/e2e-agent-*/
/e2e-www-*/
/vf-data-*/
/vf-agent-*/
/vf-www-*/

# ============================================================
# 测试临时件
#
# 正常路径下脚本会自己清干净；这里兜住异常退出时的残留。
# 都用根锚定，避免误伤代码里同名的文件。
# ============================================================
/it-result.txt
/e2e-result.txt
/e2e-cj
/e2e-frps-start.json
/vf-result-*
/vf-cj-*
/u-token.txt
/u-cj
/pa-cj
/lj
/lj2

# 手工 curl 调试时落在仓库根目录的 cookie 罐
/tk*

# 测试脚本产生的构建副本与日志
/e2e-agent-bin.exe*
/e2e-panel-bin.exe*
/it-agent-bin.exe*
/it-panel-bin.exe*
/*.log

# ============================================================
# 前端子项目 (web/)
# ============================================================
/web/node_modules/
/web/.vite/
/web/dist/

# Vite 构建产物落在 Go 侧的嵌入目录。
# 产物不入库（每次 build 文件名带 hash，diff 噪音大），但 go:embed 要求
# 目录里至少有一个文件，故保留 .keep —— 没有前端产物时 go build 仍能过，
# 面板启动会在根路径给出「先跑 npm run build」的说明页。
/internal/webui/dist/*
!/internal/webui/dist/.keep

# ============================================================
# 工具 / 编辑器 / 系统
# ============================================================
.workbuddy/
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
